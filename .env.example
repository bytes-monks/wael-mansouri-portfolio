# Copy to .env.local for `npm run dev`. In CI these come from GitHub repository
# variables of the same name (Settings -> Secrets and variables -> Actions -> Variables).
# Both are baked into the public JavaScript bundle — never put secrets here.

# WhatsApp number in international format, digits only (e.g. 21612345678).
# Empty hides the "Continue on WhatsApp" buttons.
VITE_WHATSAPP=

# Where the inquiry form POSTs JSON. Defaults to the shared formgrid.dev
# collector in src/lib/site.ts when empty.
VITE_FORM_ENDPOINT=
